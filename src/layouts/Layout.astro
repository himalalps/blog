---
import Search from '../components/Search.vue';
import { getPostSummaries } from '../lib/posts';
import { basePath, withBase } from '../lib/site';
import '../styles/global.css';

const { title, description, lang = 'zh-CN' } = Astro.props;
const searchPosts = await getPostSummaries();
const archivePath = withBase('archive');
const isArchivePage = Astro.url.pathname.replace(/\/$/, '') === archivePath;

---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const themeKey = 'vibe-theme';
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        try {
          const savedTheme = window.localStorage.getItem(themeKey);
          document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : systemTheme;
        } catch {
          document.documentElement.dataset.theme = systemTheme;
        }
      })();
    </script>
    <script is:inline>
      window.MathJax = {
        tex: {
          tags: 'ams',
          packages: { '[+]': ['ams'] },
          macros: {
            bm: ['\\boldsymbol{#1}', 1],
            R: '\\mathbb{R}',
            E: '\\mathbb{E}',
            argmax: '\\operatorname*{arg\\,max}',
            argmin: '\\operatorname*{arg\\,min}',
            on: ['\\operatorname{#1}', 1],
            dff: 'd_{\\mathrm{ff}}',
          },
        },
        svg: { fontCache: 'global' },
      };
    </script>
    <script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
    <title>{title || 'Vibe'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" href={withBase('rss.xml')} title="Vibe 博客" />
  </head>
  <body>
    <header>
      <nav>
        <a href={withBase()} class="logo">VIBE</a>
        <div class="search">
          <Search posts={searchPosts} baseUrl={basePath} client:load />
        </div>
        <div class="header-tools">
          <a
            href={archivePath}
            class="archive-link"
            aria-current={isArchivePage ? 'page' : undefined}
            aria-label="文章归档"
            title="文章归档"
          ><span class="archive-icon" aria-hidden="true">▤</span></a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="切换到深色模式"
            aria-pressed="false"
            title="切换到深色模式"
          >
            <span class="theme-icon theme-icon-dark" aria-hidden="true">☾</span>
            <span class="theme-icon theme-icon-light" aria-hidden="true">☀</span>
          </button>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-content">
        <p>&copy; {new Date().getFullYear()} Vibe</p>
        <a
          href="https://github.com/himalalps/blog"
          class="github-link"
          title="GitHub 仓库"
          aria-label="GitHub 仓库"
          target="_blank"
          rel="noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.84 1.23 1.84 1.23 1.07 1.83 2.81 1.3 3.5.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
          </svg>
        </a>
        <a
          href="https://himalalps.top"
          class="home-link"
          title="返回主站"
          aria-label="返回主站"
          target="_blank"
          rel="noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 10 9-7 9 7" />
            <path d="M5 9.5V21h14V9.5" />
            <path d="M9 21v-6h6v6" />
          </svg>
        </a>
        <a href={withBase('rss.xml')} class="rss-link" title="RSS Feed">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1"/>
          </svg>
        </a>
      </div>
    </footer>
    <style>
      footer {
        padding: 2rem 0;
        text-align: center;
      }
      
      .footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
      }
      
      .rss-link {
        order: 3;
        color: var(--text-color);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
      }

      .github-link {
        order: 2;
        color: var(--text-color);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
      }

      .github-link:hover {
        color: var(--accent-color, #0070f3);
      }

      .home-link {
        order: 1;
        color: var(--text-color);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
      }

      .home-link:hover {
        color: var(--accent-color, #0070f3);
      }
      
      .rss-link:hover {
        color: var(--accent-color, #0070f3);
      }
    </style>
    <!-- Copy code functionality -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = 'copy-notification';
        notification.textContent = '已复制';
        document.body.appendChild(notification);
        
        // Add click event listeners to code blocks
        const codeBlocks = document.querySelectorAll('pre.astro-code, .article-citation pre');
        codeBlocks.forEach(block => {
          block.style.cursor = 'pointer';
          block.title = '点击复制';
          block.addEventListener('click', function() {
            const code = this.querySelector('code').textContent;
            navigator.clipboard.writeText(code).then(() => {
              // Show notification
              notification.classList.add('show');
              setTimeout(() => {
                notification.classList.remove('show');
              }, 2000);
            });
          });
        });
      });
    </script>
    <script>
      const themeKey = 'vibe-theme';
      const themeToggle = document.querySelector('#theme-toggle');

      const syncThemeToggle = () => {
        if (!(themeToggle instanceof HTMLButtonElement)) return;

        const isDark = document.documentElement.dataset.theme === 'dark';
        const label = isDark ? '切换到浅色模式' : '切换到深色模式';
        themeToggle.setAttribute('aria-label', label);
        themeToggle.setAttribute('aria-pressed', String(isDark));
        themeToggle.title = label;
      };

      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;

        try {
          window.localStorage.setItem(themeKey, nextTheme);
        } catch {
          // The selected theme still applies for the current page.
        }

        syncThemeToggle();
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== themeKey || (event.newValue !== 'dark' && event.newValue !== 'light')) return;
        document.documentElement.dataset.theme = event.newValue;
        syncThemeToggle();
      });

      syncThemeToggle();
    </script>
    <script>
      const syncCitationTarget = () => {
        document.querySelectorAll('.references .csl-entry.is-citation-target').forEach((entry) => {
          entry.classList.remove('is-citation-target');
        });

        if (!window.location.hash.startsWith('#bib-')) return;

        let targetId = window.location.hash.slice(1);
        try {
          targetId = decodeURIComponent(targetId);
        } catch {
          // Keep the literal fragment when it is not valid URI-encoded text.
        }

        const target = document.getElementById(targetId);
        if (target?.matches('.references .csl-entry')) {
          target.classList.add('is-citation-target');
        }
      };

      document.addEventListener('click', (event) => {
        if (!window.location.hash.startsWith('#bib-')) return;
        if (!(event.target instanceof Element)) return;

        const link = event.target.closest('a[href]');
        if (link instanceof HTMLAnchorElement && link.hash.startsWith('#bib-')) return;

        window.history.replaceState(
          window.history.state,
          '',
          `${window.location.pathname}${window.location.search}`,
        );
        syncCitationTarget();
      });

      window.addEventListener('hashchange', syncCitationTarget);
      syncCitationTarget();
    </script>
    <script>
      (() => {
        const fitTable = (table) => {
          const wrapper = table.parentElement;
          if (!wrapper) return;

          if (!table.dataset.fitMarginBottom) {
            table.dataset.fitMarginBottom = getComputedStyle(table).marginBottom;
          }
          const baseMarginBottom = parseFloat(table.dataset.fitMarginBottom) || 0;

          table.style.transform = 'none';
          table.style.width = 'max-content';
          table.style.marginBottom = '';

          const availableWidth = wrapper.clientWidth;
          const contentWidth = table.scrollWidth;
          if (!availableWidth || contentWidth <= availableWidth) return;

          const scale = availableWidth / contentWidth;
          table.style.transform = `scale(${scale})`;
          table.style.width = `${contentWidth}px`;
          const layoutCompensation = table.offsetHeight * (1 - scale);
          table.style.marginBottom = `${baseMarginBottom - layoutCompensation}px`;
        };

        const tables = document.querySelectorAll('.post-content .table.fit > table');
        tables.forEach((table) => fitTable(table));

        if (typeof ResizeObserver !== 'undefined') {
          const observer = new ResizeObserver((entries) => {
            entries.forEach(({ target }) => {
              const table = target.querySelector(':scope > table');
              if (table) fitTable(table);
            });
          });
          tables.forEach((table) => observer.observe(table.parentElement));
        } else {
          window.addEventListener('resize', () => tables.forEach((table) => fitTable(table)));
        }
      })();
    </script>
  </body>
</html>
