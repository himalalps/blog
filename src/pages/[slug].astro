---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getAllPosts, toPostSummary, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, lang, cover, coverAlt } = post.data;
const { date } = toPostSummary(post);
const productionHostname = Astro.site?.hostname;
---

<Layout title={`${title} - Vibe`} description={description} lang={lang}>
  <article class="post-content">
    <p class="date">
      <time datetime={date}>{date}</time>
      <span id="vercount_container_page_pv" style="display: none;">
        <span id="vercount_value_page_pv"></span>次阅读
      </span>
    </p>
    {cover && <Image class="post-cover" src={cover} alt={coverAlt ?? title} />}
    <Content />
  </article>
  {import.meta.env.PROD && productionHostname && (
    <script is:inline define:vars={{ productionHostname }}>
      // Local previews and alternate deployment domains must not send counts.
      if (window.location.hostname === productionHostname && !window.location.port) {
        const script = document.createElement('script');
        script.defer = true;
        script.src = 'https://vercount.one/js';
        document.body.appendChild(script);
      }
    </script>
  )}
</Layout>

<style>
  .date {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .post-cover {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 2.5rem;
    border: 2px solid var(--border-color);
  }
</style>
