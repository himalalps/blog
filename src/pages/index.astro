---
import Layout from '../layouts/Layout.astro';

const posts = await Astro.glob('../content/*.md');
---

<Layout title="Vibe - Technical Blog" description="A fast, clean, and opinionated technical blog">
  <section class="hero">
    <h1>VIBE</h1>
    <p>Technical blog with minimalist design and snappy performance</p>
  </section>
  <section class="recent-posts">
    <h2>Recent Posts</h2>
    <div class="posts-grid">
      {posts.map((post) => (
        <a href={`${import.meta.env.BASE_URL}/${post.file.split('/').pop().replace('.md', '')}`} class="post-card">
          <h3>{post.frontmatter.title}</h3>
          <p>{post.frontmatter.description}</p>
          <p class="date">{post.frontmatter.date}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>